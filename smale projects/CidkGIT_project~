
def calc (first_num ,sacond_num) :
    logic = str(input(" pick what you want me to do with it + or - or * or / :"))
    if logic == "+" :
        return first_num + sacond_num
    elif logic == "-" :
        return first_num - sacond_num
    elif logic == "*" :
        return first_num * sacond_num
    elif logic == "/" :
        return first_num / sacond_num
    else :
        print("error")
a = int(input("Enter first number: "))
b = int(input("Enter second number: "))
numbers = calc(a,b)
print("Result:", numbers)